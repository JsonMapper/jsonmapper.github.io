# If you have a domain, you should set the URL here so that permalinks can be generated.
# SITE_URL=https://example.org

# Torchlight highlights code blocks at build time. Without a token the site still
# builds, but every code block renders as unhighlighted plain text.
# Get a token (free for open source) at https://torchlight.dev
# TORCHLIGHT_TOKEN=torch_

# If you want to change the default port of the realtime compiler server, you can do so here
# SERVER_PORT=8080
