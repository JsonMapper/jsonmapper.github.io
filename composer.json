{
    "name": "json-mapper/documentation",
    "description": "The documentation site for JsonMapper, built with HydePHP.",
    "keywords": [
        "json-mapper",
        "jsonmapper",
        "documentation",
        "hydephp",
        "static site generator"
    ],
    "homepage": "https://jsonmapper.net",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/JsonMapper/JsonMapper/issues",
        "source": "https://github.com/JsonMapper/jsonmapper.github.io"
    },
    "require": {
        "php": "^8.2",
        "hyde/framework": "^2.0",
        "laravel-zero/framework": "^11.0"
    },
    "require-dev": {
        "hyde/realtime-compiler": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyde\\Testing\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"@unlink('./app/storage/framework/cache/packages.php');\"",
            "@php hyde package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "hyde"
    ]
}
